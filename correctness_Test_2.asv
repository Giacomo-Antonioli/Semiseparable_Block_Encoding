% Benchmark script with:
%   - OUTSIDE n loop for incremental scale up
%   - Data saving shifted entirely OUTSIDE the experiment (e) and type (t) loops
%   - Immediate uncompressed increment saving (-v7.3) without heavy final .mat dumps
%   - Flag to skip execution and ONLY regenerate the overall plots from saved disk data
clear;
clc;
rng(42);
%% ============================================================
% CONFIGURATION
%% ============================================================
cfg.n_range               = 1:3;
cfg.num_runs               = 1;                    % runs per (experiment, n, type)
cfg.num_experiments        = 1;                     % full independent repetitions
cfg.type_names              = {'Random','Tridiagonal','Exponential'};
cfg.save_formats            = {'png','eps','fig'};  % remove entries to save disk/time
cfg.enable_saving           = true;                 % master switch: save anything to disk (mat/csv/figures)?
cfg.enable_unitarity_check  = false;                % compute ||U'*U - I||_2 and its plot?

% --- NEW FLAG ---
cfg.generate_plots_only     = false;                % TRUE: skips simulation, reads disk data, outputs overall figure.
cfg.load_timestamp          = '';                   % If generate_plots_only is true, specify folder timestamp here (blank for latest)

n_types = numel(cfg.type_names);
colors  = lines(n_types);
markers = {'o','s','d','^','v','p','h'};    
markers = markers(mod(0:n_types-1, numel(markers)) + 1);
num_n       = length(cfg.n_range);
total_tasks = num_n * n_types * cfg.num_runs * cfg.num_experiments;

%% ============================================================
% CONDITIONAL EXECUTION BLOCK
%% ============================================================
if ~cfg.generate_plots_only
    
    %% ============================================================
    % FOLDERS CREATION
    %% ============================================================
    timestamp     = datestr(now, 'yyyy-mm-dd_HH-MM-SS');
    base_folder   = fullfile('results', timestamp);
    latest_folder = fullfile('results', 'latest');
    plots_folder  = fullfile(base_folder, 'plots');
    if cfg.enable_saving
        if ~exist(base_folder, 'dir');   mkdir(base_folder);   end
        if ~exist(latest_folder, 'dir'); mkdir(latest_folder); end
        if ~exist(plots_folder, 'dir');  mkdir(plots_folder);  end
    end

    %% ============================================================
    % LIVE PLOTS INITIALIZATION
    %% ============================================================
    fig_err = figure('Name', 'Live: Semiseparable Error', 'NumberTitle', 'off');
    ax_err = axes(fig_err); hold(ax_err, 'on');
    h_err = gobjects(n_types, 1);
    for t = 1:n_types
        h_err(t) = scatter(ax_err, NaN, NaN, 80, ...
            'Marker', markers{t}, 'MarkerEdgeColor', colors(t, :), ...
            'MarkerFaceColor', 'none', 'LineWidth', 1.5, ...
            'DisplayName', cfg.type_names{t});
    end
    xlabel(ax_err, 'n'); ylabel(ax_err, '$\|S - \tilde{S}\|_2$', 'Interpreter', 'latex');
    title(ax_err, 'Error');
    grid(ax_err, 'on'); legend(ax_err, h_err, 'Location', 'eastoutside');
    
    if cfg.enable_unitarity_check
        fig_unit = figure('Name', 'Live: Unitarity Error', 'NumberTitle', 'off');
        ax_unit = axes(fig_unit); hold(ax_unit, 'on');
        h_unit = gobjects(n_types, 1);
        for t = 1:n_types
            h_unit(t) = scatter(ax_unit, NaN, NaN, 80, ...
                'Marker', markers{t}, 'MarkerEdgeColor', colors(t, :), ...
                'MarkerFaceColor', 'none', 'LineWidth', 1.5, ...
                'DisplayName', cfg.type_names{t});
        end
        xlabel(ax_unit, 'n'); ylabel(ax_unit, '$\|U^\dagger U - I\|_2$', 'Interpreter', 'latex');
        title(ax_unit, 'Error');
        grid(ax_unit, 'on'); legend(ax_unit, h_unit, 'Location', 'eastoutside');
    end
    drawnow;

    %% ============================================================
    % INCREMENTAL EXECUTION: N LOOP OUTSIDE
    %% ============================================================
    done_tasks  = 0;
    tic;
    
    for ni = 1:num_n
        n = cfg.n_range(ni);
        N = 2^n;
        
        % Temporary storage buffer to hold current n's data across all experiments & types
        n_block_data = cell(cfg.num_experiments, n_types);
        
        for e = 1:cfg.num_experiments
            for t = 1:n_types
                errs       = zeros(cfg.num_runs, 1);
                rel_errs   = zeros(cfg.num_runs, 1);
                unit_errs  = zeros(cfg.num_runs, 1);
                failed     = false(cfg.num_runs, 1);
                u_cell     = cell(cfg.num_runs, 1);
                v_cell     = cell(cfg.num_runs, 1);
                S_cell     = cell(cfg.num_runs, 1);
                Stilde_cell = cell(cfg.num_runs, 1);
                
                for r = 1:cfg.num_runs
                    
                    [u, v] = local_generate_uv(n, t);
                    S      = tril(u*v') + triu(v*u', 1);
                    U      = [];
                    S_tilde = zeros(N);
                    unit_err = NaN;
                    
                    %try
                        circ = build_semiseparable_circuit(u, v);
                        % U       = circ.matrix;
                        % S_tilde = 2*sqrt(N) * U(1:N, 1:N);
                        dim = 2^circ.nbQubits;
                        psi = zeros(dim,1);
                        
                        for j = 1:N
                            psi(:) = 0;
                            psi(j) = 1;
                        
                            sim = circ.simulate(psi);
                           out = sim.states;
                        
                            S_tilde(:,j) = 2*sqrt(N) * out(1:N);
                        end
                        errs(r)     = norm(S_tilde - S, 2);
                        normS       = norm(S, 2);
                        rel_errs(r) = errs(r) / max(normS, eps);
                        if cfg.enable_unitarity_check
                            Iu = eye(size(U, 1));
                            unit_err     = norm(U' * U - Iu, 2);
                            unit_errs(r) = unit_err;
                        end
                    catch ME
                        warning('Run failed (exp=%d, n=%d, type=%d, run=%d): %s', ...
                           e, n, t, r, ME.message);
                        errs(r)      = NaN;
                        rel_errs(r)  = NaN;
                        unit_errs(r) = NaN;
                        failed(r)    = true;
                    end
                    
                    u_cell{r}      = u;
                    v_cell{r}      = v;
                    S_cell{r}      = S;
                    Stilde_cell{r} = S_tilde;
                    
                    % Live visualization update
                    if ~failed(r)
                        scatter(ax_err, n, errs(r), 80, ...
                            'Marker', markers{t}, 'MarkerEdgeColor', colors(t, :), ...
                            'MarkerFaceColor', 'none', 'LineWidth', 1.5, ...
                            'HandleVisibility', 'off');
                        if cfg.enable_unitarity_check
                            scatter(ax_unit, n, unit_errs(r), 80, ...
                                'Marker', markers{t}, 'MarkerEdgeColor', colors(t, :), ...
                                'MarkerFaceColor', 'none', 'LineWidth', 1.5, ...
                                'HandleVisibility', 'off');
                        end
                        drawnow;
                    end
                    
                    done_tasks = done_tasks + 1;
                    print_progress(done_tasks, total_tasks, e, n, t, r, cfg.num_runs);
                end
                
                % Buffer everything safely into the workspace collector
                n_block_data{e, t}.errs = errs;
                n_block_data{e, t}.rel_errs = rel_errs;
                n_block_data{e, t}.unit_errs = unit_errs;
                n_block_data{e, t}.failed = failed;
                n_block_data{e, t}.u_cell = u_cell;
                n_block_data{e, t}.v_cell = v_cell;
                n_block_data{e, t}.S_cell = S_cell;
                n_block_data{e, t}.Stilde_cell = Stilde_cell;
            end
        end
        
        % -----------------------------------------------------------------
        % DISK SAVE WRITE ENGINE: Executed cleanly AFTER the e loop wraps
        % -----------------------------------------------------------------
        if cfg.enable_saving
            for e_save = 1:cfg.num_experiments
                exp_folder = fullfile(base_folder, sprintf('exp_%d', e_save));
                runs_folder = fullfile(exp_folder, 'runs');
                if ~exist(exp_folder, 'dir'); mkdir(exp_folder); end
                if ~exist(runs_folder, 'dir'); mkdir(runs_folder); end
                
                for t_save = 1:n_types
                    b_data = n_block_data{e_save, t_save};
                    
                    % Unpack and write raw execution loops
                    for r_save = 1:cfg.num_runs
                        run_file = fullfile(runs_folder, sprintf('n%d_type%d_run%d.mat', n, t_save, r_save));
                        u = b_data.u_cell{r_save}; 
                        v = b_data.v_cell{r_save}; 
                        S = b_data.S_cell{r_save}; 
                        S_tilde = b_data.Stilde_cell{r_save};
                        errs = b_data.errs(r_save);
                        rel_errs = b_data.rel_errs(r_save);
                        unit_errs = b_data.unit_errs(r_save);
                        failed = b_data.failed(r_save);
                        
                        save(run_file, 'u', 'v', 'S', 'S_tilde', 'errs', 'rel_errs', 'unit_errs', ...
                             'failed', 'n', 't_save', 'r_save', 'e_save', '-v7.3');
                    end
                    
                    % Save structured timeline summaries incrementally via append
                    partial_history_file = fullfile(exp_folder, 'incremental_history.mat');
                    block_data.errs = b_data.errs;
                    block_data.rel_errs = b_data.rel_errs;
                    block_data.unit_errs = b_data.unit_errs;
                    block_data.failed = b_data.failed;
                    
                    if exist(partial_history_file, 'file')
                        save(partial_history_file, 'block_data', '-append', '-v7.3');
                    else
                        save(partial_history_file, 'block_data', '-v7.3');
                    end
                end
            end
        end
        
    end
    elapsed = toc;
    fprintf('\nExperiment completed in %.2f seconds (%.2f min)\n', elapsed, elapsed/60);
    print_final_summary(base_folder,cfg);
    if cfg.enable_saving
        generate_csv_summaries(base_folder, latest_folder, cfg);
    end
else
    if isempty(cfg.load_timestamp)
        target_dir = fullfile('results', 'latest');
    else
        target_dir = fullfile('results', cfg.load_timestamp);
    end
    fprintf('Bypassing benchmarks. Building consolidated graphics directly from: %s\n', target_dir);
end

%% ============================================================
% PROCESS POST-EXPERIMENT / OVERALL FIGURE GENERATION FUNCTION
%% ============================================================
if cfg.enable_saving || cfg.generate_plots_only
    if cfg.generate_plots_only
        if isempty(cfg.load_timestamp)
            base_folder = fullfile('results', 'latest');
        else
            base_folder = fullfile('results', cfg.load_timestamp);
        end
        plots_folder = fullfile(base_folder, 'plots');
        latest_folder = fullfile('results', 'latest');
    end
    
    generate_overall_plots(base_folder, plots_folder, latest_folder, cfg, markers, colors);
end
